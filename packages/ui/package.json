{
  "name": "@vaultly/ui",
  "version": "0.1.0",
  "description": "Vaultly design system: Tailwind theme tokens, base styles and React components shared by all frontends.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css"
  },
