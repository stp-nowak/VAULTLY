{
  "ConnectionStrings": {
    "TransactionsDb": "Host=localhost;Port=5434;Database=vaultly_transactions;Username=postgres;Password=postgres",
    "RabbitMq": "amqp://vaultly:vaultly@localhost:5672"
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "InternalTokens": {
    "Issuer": "vaultly-gateway",
    "Audience": "transactions",
    "JwksUrl": "https://gateway.vaultly.local/.well-known/jwks.json"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
