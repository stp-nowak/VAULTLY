<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Vaultly.Accounts.Application/Vaultly.Accounts.Application.csproj" />
    <ProjectReference Include="../../../core/src/Vaultly.Core.Persistence/Vaultly.Core.Persistence.csproj" />
    <ProjectReference Include="../../../core/src/Vaultly.Core.Messaging.Rebus/Vaultly.Core.Messaging.Rebus.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MediatR" Version="15.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.4" />
    <!-- Pinned to the Design package's version: Design is private, so without this the API would ship the older
         Relational assembly that Npgsql brings in and fail to load at runtime. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
  </ItemGroup>
</Project>
