{
  "ConnectionStrings": {
    "AccountsDb": "Host=localhost;Port=5433;Database=vaultly_accounts;Username=postgres;Password=postgres"
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "InternalTokens": {
    "Issuer": "vaultly-gateway",
    "Audience": "accounts",
    "JwksUrl": "https://gateway.vaultly.local/.well-known/jwks.json"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
