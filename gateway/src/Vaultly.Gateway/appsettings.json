{
  "UserTokens": {
    "Issuer": "https://identity.vaultly.local",
    "Audience": "vaultly.api",
    "JwksUrl": "https://identity.vaultly.local/.well-known/jwks.json"
  },
  "InternalTokens": {
    "Issuer": "vaultly-gateway",
    "LifetimeMinutes": 5,
    "SigningKeyPemFilePath": ".secrets/gateway-signing-key.pem",
    "AutoGenerateDevelopmentSigningKey": false
  },
  "ReverseProxy": {
    "Routes": {
      "accounts": {
        "ClusterId": "accounts",
        "Match": {
          "Path": "/accounts/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "accounts": {
        "Destinations": {
          "main": {
            "Address": "http://accounts-api:8080"
          }
        }
      }
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Yarp": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
