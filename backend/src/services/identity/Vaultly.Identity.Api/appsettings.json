{
  "ConnectionStrings": {
    "IdentityDb": "Host=localhost;Database=vaultly_identity;Username=postgres;Password=postgres"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Identity": {
    "Issuer": "https://identity.vaultly.local",
    "Audience": "vaultly.api",
    "PublicBaseUrl": "https://identity.vaultly.local",
    "AllowedRedirectUris": [ "https://app.vaultly.local/callback" ],
    "JwtPrivateKeyPemFilePath": ".secrets/identity-jwt-private-key.pem",
    "AutoGenerateDevelopmentJwtPrivateKey": false,
    "AccessTokenTtlMinutes": 15,
    "RefreshTokenTtlDays": 30,
    "AuthCodeTtlMinutes": 2,
    "OAuthStateTtlMinutes": 10,
    "RefreshTokenCookieDomain": null
  },
  "Google": {
    "Enabled": true,
    "ClientId": "REPLACE_WITH_GOOGLE_CLIENT_ID",
    "ClientSecret": "REPLACE_WITH_GOOGLE_CLIENT_SECRET",
    "RedirectUri": "https://identity.vaultly.local/google/callback",
    "AuthorizationEndpoint": "https://accounts.google.com/o/oauth2/v2/auth",
    "TokenEndpoint": "https://oauth2.googleapis.com/token",
    "Scopes": [ "openid", "email", "profile" ]
  },
  "AllowedHosts": "*"
}
