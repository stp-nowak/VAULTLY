# Copy this file to .env and replace the placeholder values for local development.
# Use native .NET configuration keys. Dotenv values override appsettings.json values.
# Prefer pointing to a local PEM file instead of embedding the private key in configuration.

ConnectionStrings__IdentityDb=Host=localhost;Database=vaultly_identity;Username=postgres;Password=postgres

Identity__Issuer=https://identity.vaultly.local
Identity__Audience=vaultly.api
Identity__PublicBaseUrl=https://identity.vaultly.local
Identity__JwtPrivateKeyPemFilePath=.secrets/identity-jwt-private-key.pem
Identity__AutoGenerateDevelopmentJwtPrivateKey=true
# Optional backward-compatible fallback if you cannot use a file path:
# Identity__JwtPrivateKeyPem="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_RSA_PRIVATE_KEY\n-----END PRIVATE KEY-----"
Identity__AccessTokenTtlMinutes=15
Identity__RefreshTokenTtlDays=30
Identity__AuthCodeTtlMinutes=2
Identity__OAuthStateTtlMinutes=10
Identity__RefreshTokenCookieDomain=

Google__Enabled=true
Google__ClientId=REPLACE_WITH_GOOGLE_CLIENT_ID
Google__ClientSecret=REPLACE_WITH_GOOGLE_CLIENT_SECRET
Google__RedirectUri=https://identity.vaultly.local/google/callback
Google__AuthorizationEndpoint=https://accounts.google.com/o/oauth2/v2/auth
Google__TokenEndpoint=https://oauth2.googleapis.com/token
Google__Scopes__0=openid
Google__Scopes__1=email
Google__Scopes__2=profile

Frontend__CallbackUrl=https://app.vaultly.local/callback
Frontend__AllowedBaseUrl=https://app.vaultly.local
