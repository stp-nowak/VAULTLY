{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "ConnectionStrings": {
    "IdentityDb": "Host=localhost;Database=vaultly_identity;Username=postgres;Password=postgres"
  },
  "Identity": {
    "Issuer": "http://localhost:5096",
    "Audience": "vaultly.api",
    "PublicBaseUrl": "http://localhost:5096",
    "AllowedRedirectUris": [ "http://localhost:5173/*" ],
    "AutoGenerateDevelopmentJwtPrivateKey": true,
    "AccessTokenTtlMinutes": 15,
    "RefreshTokenTtlDays": 30,
    "AuthCodeTtlMinutes": 2,
    "OAuthStateTtlMinutes": 10,
    "RefreshTokenCookieDomain": null
  },
  "Google": {
    "Enabled": true,
    "ClientId": "REPLACE_WITH_GOOGLE_CLIENT_ID",
    "ClientSecret": "REPLACE_WITH_GOOGLE_CLIENT_SECRET",
    "RedirectUri": "http://localhost:5096/google/callback"
  }
}
