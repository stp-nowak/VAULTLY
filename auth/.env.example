# Copy to auth/.env (git-ignored); auth/docker-compose.yml reads it automatically.
# Google OAuth client of the Identity service. Register http://localhost:5096/google/callback as its redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Your Google email: made the first admin of the admin console (http://localhost:5174/admin) while no admin exists.
BOOTSTRAP_ADMIN_EMAIL=
# Optional password (12-128 characters) for that admin, to sign in to the console without Google.
BOOTSTRAP_ADMIN_PASSWORD=
