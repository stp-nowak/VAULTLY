<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vaultly.Identity.Domain\Vaultly.Identity.Domain.csproj" />
    <ProjectReference Include="..\Vaultly.Identity.Application\Vaultly.Identity.Application.csproj" />
    <ProjectReference Include="../../../core/src/Vaultly.Core.Persistence/Vaultly.Core.Persistence.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MediatR" Version="12.5.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.15" />
    <!-- Pinned to the Design package's version: Design is private, so without this the API would ship the older
         Relational assembly that Npgsql brings in and fail to load at runtime. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Google.Apis.Auth" Version="1.78.0" />
    <PackageReference Include="Microsoft.Extensions.Identity.Core" Version="10.0.15" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.4" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Vaultly.Identity.Application.Tests" />
  </ItemGroup>
</Project>
