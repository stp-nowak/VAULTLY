{
  "baseUrl": "http://localhost:4173",
  "channel": "msedge",
  "outDir": "shots",
  "viewports": [
    { "name": "desktop", "width": 1440, "height": 900 },
    { "name": "mobile", "width": 390, "height": 844 }
  ],
  "colorSchemes": ["dark"],
  "mocks": {
    "**/api/auth/user": { "status": 401 }
  },
  "scenarios": [
    { "name": "login", "path": "/login", "waitFor": "button" },
    { "name": "login-error", "path": "/login?error=invalid_state", "waitFor": "button" },
    {
      "name": "dashboard",
      "path": "/app",
      "waitFor": "text=Current session",
      "mocks": {
        "**/api/auth/user": {
          "body": {
            "sessionId": "5b0f3d1e-0000-4000-8000-000000000001",
            "user": { "id": "u-1", "email": "alex@example.com", "name": "Alex Example" }
          }
        },
        "**/api/auth/sessions": {
          "body": {
            "sessions": [
              {
                "id": "5b0f3d1e-0000-4000-8000-000000000001",
                "createdAt": "2026-11-20T08:15:00Z",
                "lastUsedAt": "2026-11-21T09:30:00Z",
                "userAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) Edge/131",
                "ipAddress": null,
                "isRevoked": false,
                "isCurrent": true
              }
            ]
          }
        }
      }
    }
  ]
}
