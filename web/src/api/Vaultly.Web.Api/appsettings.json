{
  "ConnectionStrings": {
    "Redis": "localhost:6379"
  },
  "Auth": {
    "IdentityBaseUrl": "https://identity.vaultly.local",
    "PublicOrigin": "https://app.vaultly.local",
    "SessionCookieName": "__Host-vaultly-session",
    "LoginCookieName": "__Host-vaultly-login",
    "LoginTimeoutMinutes": 10,
    "AccessTokenRefreshSkewSeconds": 60,
    "DefaultReturnPath": "/app",
    "LoginPagePath": "/login"
  },
  "Web": {
    "BackendApiBaseUrl": "https://api.vaultly.local",
    "ServeSpa": true,
    "SpaRootPath": "wwwroot"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
