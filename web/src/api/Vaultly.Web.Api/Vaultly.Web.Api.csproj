<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Vaultly.Web.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Redis-backed IDistributedCache: server-side store for per-session tokens. -->
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="11.0.0" />
    <!-- Shares Data Protection keys between API instances so encrypted sessions/cookies survive restarts. -->
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.StackExchangeRedis" Version="11.0.0" />
    <!-- YARP forwarder: streams /api/* calls to the backend with the session's bearer token attached. -->
    <PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.2" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="8.0.2" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Request/response models of the Identity API, owned by ./auth. -->
    <ProjectReference Include="../../../../auth/src/Vaultly.Identity.ApiContracts/Vaultly.Identity.ApiContracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Vaultly.Web.Api.Tests" />
  </ItemGroup>
</Project>
